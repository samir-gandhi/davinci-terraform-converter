# PingOne Provider Configuration
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

pingone_client_id      = "your-terraform-client-id"
pingone_client_secret  = "your-terraform-client-secret"
pingone_environment_id = "your-target-environment-id"
pingone_region_code    = "NA"  # or EU, AP, CA, AU

# DaVinci Environment
environment_id = "your-davinci-environment-id"  # Usually same as pingone_environment_id
